{
  "name": "replaid-web",
  "compatibility_date": "2026-02-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/404",
      "/404/",
      "/404.html"
    ]
  },
  "main": "src/error-page-worker.mjs"
}
