---
import type { CollectionEntry } from 'astro:content';
import BlogArtwork from './BlogArtwork.astro';
import BlogMeta from './BlogMeta.astro';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean; }
const { post, featured = false } = Astro.props;
const titleId = `post-${post.id}`;
---
<article class:list={['blog-post', { 'blog-post-featured': featured }]} data-blog-post data-category={post.data.category}>
  <a class="blog-post-link" href={`/${post.id}`} aria-labelledby={post.data.historical ? `${titleId} ${titleId}-status` : titleId}>
    <div class="blog-post-cover">
      {post.data.image ? <img src={post.data.image} width="880" height="640" alt="" loading={featured ? 'eager' : 'lazy'} decoding="async" /> : <BlogArtwork id={post.id} />}
    </div>
    <div class="blog-post-copy">
      <div class="blog-post-labels"><span class="blog-category">{post.data.category}</span>{post.data.historical && <span id={`${titleId}-status`} class="blog-history-label">Historical</span>}</div>
      <h2 id={titleId}>{post.data.title}</h2>
      <p>{post.data.description}</p>
      <BlogMeta post={post} />
      {featured && <span class="blog-featured-link">Read article<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></span>}
    </div>
  </a>
</article>
