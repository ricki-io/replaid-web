---
const features = [
  { title: 'Conversation context', desc: 'Give your agent the messages, contact details, and conversation state it needs before it acts.' },
  { title: 'Controlled actions', desc: 'Choose which actions are allowed. Start with drafts, check a proposed action, and enable replies when you are ready.' },
  { title: 'Human handoff', desc: 'Let the agent flag a conversation for a person and pause its automation. Resume when it is ready for the agent again.' },
  { title: 'Action history', desc: 'See what the agent requested and whether it succeeded, failed, or was blocked by a policy.' },
];
---

<section id="features" class="py-16 sm:py-24 px-6 border-t border-overlay/10">
  <div class="mx-auto max-w-7xl grid lg:grid-cols-[1fr_1.4fr] gap-12 lg:gap-20">
    <div>
      <h2 class="text-display-sm max-w-md">Give your agent access. Keep control of its actions.</h2>
      <p class="mt-6 text-ink-200 text-lg leading-relaxed max-w-md">Your agent provides the knowledge and instructions. Replaid provides the conversation context, checks permissions, and records the result.</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-10">
      {features.map((feature) => (
        <div class="border-t-2 border-accent pt-5">
          <h3 class="text-xl mb-3">{feature.title}</h3>
          <p class="text-ink-200 leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
