---
// Typography First Footer - minimal, type-focused
---

<footer class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10">
      <!-- Logo -->
      <div>
        <a href="/" class="font-display text-3xl font-bold tracking-tight">
          Replaid<span class="text-accent">.</span>
        </a>
        <p class="text-ink-300 mt-2 text-sm">A customer inbox for your AI agent.</p>
      </div>
      
      <!-- Links -->
      <div class="flex flex-wrap gap-10 sm:gap-20">
        <!-- Product -->
        <div class="space-y-4">
          <div class="text-xs font-mono uppercase tracking-widest text-ink-200">Product</div>
          <div class="flex flex-col gap-3">
            <a href="/#features" class="text-ink-200 hover:text-fg transition-colors">Features</a>
            <a href="/#pricing" class="text-ink-200 hover:text-fg transition-colors">Pricing</a>
            <a href="/#faq" class="text-ink-200 hover:text-fg transition-colors">FAQ</a>
            <a href="/docs/connect-your-agent" class="text-ink-200 hover:text-fg transition-colors">Docs</a>
          </div>
        </div>
        
        <!-- Company -->
        <div class="space-y-4">
          <div class="text-xs font-mono uppercase tracking-widest text-ink-200">Company</div>
          <div class="flex flex-col gap-3">
            <a href="/blog" class="text-ink-200 hover:text-fg transition-colors">Blog</a>
            <a href="/contact" class="text-ink-200 hover:text-fg transition-colors">Contact</a>
            <a href="https://replaid.instatus.com/" target="_blank" rel="noopener noreferrer" class="text-ink-200 hover:text-fg transition-colors">Status</a>
          </div>
        </div>
        
        <!-- Legal -->
        <div class="space-y-4">
          <div class="text-xs font-mono uppercase tracking-widest text-ink-200">Legal</div>
          <div class="flex flex-col gap-3">
            <a href="/privacy" class="text-ink-200 hover:text-fg transition-colors">Privacy</a>
            <a href="/terms" class="text-ink-200 hover:text-fg transition-colors">Terms</a>
            <a href="/cookies" class="text-ink-200 hover:text-fg transition-colors">Cookies</a>
          </div>
        </div>
      </div>
      
      <!-- Copyright -->
      <div class="mono-label">© 2026 Replaid</div>
    </div>
  </div>
</footer>
