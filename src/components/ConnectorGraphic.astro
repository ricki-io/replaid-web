---
import BrandLogo from './BrandLogo.astro';
const channels = [
  { platform: 'instagram', label: 'Instagram' },
  { platform: 'messenger', label: 'Messenger' },
  { platform: 'telegram', label: 'Telegram' },
  { platform: 'whatsapp', label: 'WhatsApp' },
  { platform: 'tiktok', label: 'TikTok' },
] as const;
---
<figure class="connector-figure" aria-label="Customer channels connect through Replaid to your external AI agent. Replaid provides context, permissions, and actions.">
  <div class="connector-graphic">
    <img class="connector-atmosphere" src="/connector-sky.webp" width="1536" height="1024" alt="" aria-hidden="true" fetchpriority="high" />
    <svg class="connector-lines" viewBox="0 0 1000 360" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <defs><filter id="line-glow"><feGaussianBlur stdDeviation="3" /></filter></defs>
      <g stroke="white" stroke-width="6" opacity=".3" filter="url(#line-glow)">
        <path d="M190 45C285 45 290 167 420 167M110 100C265 100 280 175 420 175M190 150C300 150 295 183 420 183M110 205C270 205 290 191 420 191M190 260C300 260 300 199 420 199M610 171C670 147 685 171 754 171M610 205C680 229 690 205 754 205" />
      </g>
      <g stroke="white" stroke-width="2" opacity=".95">
        <path d="M190 45C285 45 290 167 420 167M110 100C265 100 280 175 420 175M190 150C300 150 295 183 420 183M110 205C270 205 290 191 420 191M190 260C300 260 300 199 420 199" />
        <path d="M610 171C670 147 685 171 754 171l-9-5m9 5-9 5M754 205C690 205 680 229 610 205l9-4m-9 4 7 7" />
      </g>
    </svg>
    <div class="channel-cluster">
      {channels.map((channel, index) => (
        <a class:list={['connector-tile', 'liquid-glass', 'channel-node', `channel-node-${index}`]} href="#connections" aria-label={`${channel.label}. Explore connections.`}>
          <BrandLogo platform={channel.platform} />
          <span class="node-tooltip">{channel.label}</span>
        </a>
      ))}
      <a class="connector-tile liquid-glass channel-node channel-node-more" href="#connections" aria-label="Explore more connections"><span aria-hidden="true">•••</span></a>
    </div>
    <div class="replaid-node">
      <svg class="mobile-connector-arrow" width="40" height="52" viewBox="0 0 40 52" fill="none" aria-hidden="true">
        <path class="mobile-arrow-glow" d="M20 5v40m-10-10 10 10 10-10" />
        <path d="M20 5v40m-10-10 10 10 10-10" />
      </svg>
      <div class="connector-tile liquid-glass replaid-tile">
        <img class="replaid-tile-logo" src="/favicon.svg" width="518" height="553" alt="" aria-hidden="true" />
        <span class="replaid-tile-wordmark">Replaid</span>
      </div>
    </div>
    <div class="agent-node">
      <svg class="mobile-connector-arrow" width="40" height="52" viewBox="0 0 40 52" fill="none" aria-hidden="true">
        <path class="mobile-arrow-glow" d="M20 5v40m-10-10 10 10 10-10" />
        <path d="M20 5v40m-10-10 10 10 10-10" />
      </svg>
      <div class="connector-tile liquid-glass agent-ghost ghost-top" title="Claude">
        <img class="agent-brand-logo" src="/claude.svg" width="64" height="64" alt="Claude" />
      </div>
      <div class="connector-tile liquid-glass agent-ghost ghost-bottom" title="Hermes Agent">
        <img class="agent-brand-logo hermes-nous-logo" src="/hermes-agent-nous.png" width="64" height="64" alt="Hermes Agent" />
      </div>
      <div class="connector-tile liquid-glass agent-tile" title="ChatGPT">
        <img class="agent-brand-logo chatgpt-logo" src="/chatgpt.svg" width="112" height="112" alt="ChatGPT" />
      </div>
    </div>
  </div>
</figure>
