---
import { useCases, setupService } from './use-cases';
---
<footer class="sky-footer">
  <div class="sky-footer-main">
    <div class="sky-footer-brand">
      <a class="sky-wordmark sky-nav-brand" href="/" aria-label="Replaid home"><img src="/favicon.svg" width="28" height="30" alt="" aria-hidden="true" /><span>Replaid</span></a>
      <p>A customer inbox for your AI agent.</p>
    </div>
    <nav aria-label="Product">
      <h3>Product</h3>
      <a href="/#features">Features</a>
      <a href="/pricing/">Pricing</a>
      <a href="/#faq">FAQ</a>
      <a href="/docs/connect-your-agent/">Documentation</a>
    </nav>
    <nav aria-label="Company">
      <h3>Company</h3>
      <a href="/blog/">News &amp; articles</a>
      <a href="/contact/">Contact</a>
      <a href={`${setupService.url}?from=footer`}>Setup &amp; managed service</a>
      <a href="https://replaid.instatus.com/" target="_blank" rel="noopener noreferrer">Status</a>
    </nav>
    <nav aria-label="Use Cases">
      <h3>Use Cases</h3>
      {useCases.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
    <nav aria-label="Compare">
      <h3>Compare</h3>
      <a href="/compare/manychat/">Replaid vs Manychat</a>
      <a href="/compare/respond-io/">Replaid vs respond.io</a>
    </nav>
    <nav aria-label="Legal">
      <h3>Legal</h3>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/cookies/#preferences">Cookies</a>
    </nav>
  </div>
  <div class="sky-footer-bottom"><span>© {new Date().getFullYear()} Replaid</span></div>
</footer>
<style>
  .sky-footer-main { grid-template-columns: 1.3fr .9fr 1.3fr 1.3fr 1.1fr .7fr; gap: 24px; }
  @media (min-width: 851px) and (max-width: 1050px) { .sky-footer-main { grid-template-columns: repeat(3, minmax(0, 1fr)); } .sky-footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 850px) { .sky-footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; } .sky-footer-brand { grid-column: 1 / -1; } }
</style>
