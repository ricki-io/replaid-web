---
import { faqs } from './faq-content';
---

<section id="faq" class="py-16 sm:py-24 px-6">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-display-sm mb-10">Before you connect.</h2>
    <div class="divide-y divide-overlay/15">
      {faqs.map((faq) => (
        <details class="group">
          <summary class="py-6 font-display text-lg sm:text-xl font-semibold cursor-pointer flex justify-between items-center gap-6 list-none">
            {faq.q}
            <span class="text-ink-200 group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
          </summary>
          <p class="pb-6 text-ink-200 leading-relaxed max-w-3xl">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
