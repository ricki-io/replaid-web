---
import SkyHeader from './SkyHeader.astro';
import ConnectorGraphic from './ConnectorGraphic.astro';
---
<section class="sky-hero" aria-labelledby="hero-heading">
  <SkyHeader />
  <div class="sky-hero-copy">
    <h1 id="hero-heading">Connect your AI agent<br class="desktop-break" /> to your customers.</h1>
    <p>Bring your agent. Connect your channels. Control what happens next.</p>
    <a class="sky-button" href="https://app.replaid.pro/register">Connect your agent</a>
    <span class="hero-supporting">Built for MCP and API</span>
  </div>
  <ConnectorGraphic />
</section>
