---
import SkyHeader from './SkyHeader.astro';
import { registration } from './product-copy';
import ConnectorGraphic from './ConnectorGraphic.astro';
---
<section class="sky-hero" aria-labelledby="hero-heading">
  <SkyHeader />
  <div class="sky-hero-copy">
    <h1 id="hero-heading">Let <span class="hero-highlight">your AI agent</span> read<br class="desktop-break" /> and reply to customer messages.</h1>
    <p>Connect your channels to ChatGPT, Claude, or Hermes Agent. You bring the knowledge and instructions, and control what it can read, draft, and send.</p>
    <span class="hero-supporting">
      <a class="hero-uneed" href="https://www.uneed.best/tool/replaid" target="_blank" rel="noopener noreferrer">
        <strong>Voted #1 on Uneed</strong><span aria-hidden="true">★</span>
      </a>
    </span>
    <a class="sky-button" href={registration.url}>{registration.label}</a>
    <p class="hero-registration-note">{registration.note}</p>
  </div>
  <ConnectorGraphic />
</section>
