---
// 3D Interactive Hero — Three.js particle vortex with overlaid typography
import InboxMockup from './InboxMockup.astro';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Three.js canvas container — fills the entire hero behind content -->
  <div id="hero-canvas-container" class="hero-canvas"></div>

  <!-- Gradient overlay for text readability -->
  <div class="hero-overlay"></div>

  <!-- Hero content — layered above the 3D scene -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 py-24 sm:py-32 w-full box-border">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Badge -->
      <a href="https://www.uneed.best/tool/replaid" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mb-8 fade-in-up hover:opacity-80 transition-opacity">
        <span class="mono-label text-ink-100">Voted #1 on Uneed</span>
        <span class="text-accent">★</span>
      </a>

      <!-- Massive headline -->
      <h1 class="hero-headline fade-in-up">
        Money is in<br/>
        your <span class="text-accent">inbox</span><span class="text-white">.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl md:text-2xl text-ink-100 max-w-2xl mx-auto mb-12 leading-relaxed fade-in-up font-light hero-sub">
        AI-powered inbox assistant that qualifies leads and triggers automations to keep your pipeline moving 24/7.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-12 fade-in-up">
        <a href="https://app.replaid.pro/register" class="btn-type">
          Start Free Trial
        </a>
        <a href="#how-it-works" class="btn-type-outline">
          How It Works
        </a>
      </div>

      <!-- Connects With -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6 mb-16 fade-in-up">
        <span class="mono-label shrink-0">Connects With</span>
        <div class="flex flex-wrap justify-center items-center gap-5 sm:gap-8">
          <span class="channel-icon" title="Instagram">
            <svg width="22" height="22" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8z"/></svg>
            <span class="channel-label">Instagram</span>
          </span>
          <span class="channel-icon" title="WhatsApp">
            <svg width="22" height="22" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            <span class="channel-label">WhatsApp</span>
          </span>
          <span class="channel-icon" title="Messenger">
            <svg width="22" height="22" viewBox="0 0 448 512" fill="currentColor"><path d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64h98.2V334.2H109.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H255V480H384c35.3 0 64-28.7 64-64V96c0-35.3-28.7-64-64-64H64z"/></svg>
            <span class="channel-label">Messenger</span>
          </span>
          <span class="channel-icon" title="Telegram">
            <svg width="22" height="22" viewBox="0 0 496 512" fill="currentColor"><path d="M248 8C111 8 0 119 0 256S111 504 248 504 496 393 496 256 385 8 248 8zM363 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5q-3.3 .7-104.6 69.1-14.8 10.2-26.9 9.9c-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3q.8-6.7 18.5-13.7 108.4-47.2 144.6-62.3c68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9a10.5 10.5 0 0 1 3.5 6.7A43.8 43.8 0 0 1 363 176.7z"/></svg>
            <span class="channel-label">Telegram</span>
          </span>
          <span class="channel-icon" title="Web Widget">
            <svg width="22" height="22" viewBox="0 0 512 512" fill="currentColor"><path d="M256 32C114.6 32 0 125.1 0 240c0 49.6 21.4 95 57 130.7C44.5 421.1 2.7 466 2.2 466.5c-2.2 2.3-2.8 5.7-1.5 8.7S4.8 480 8 480c66.3 0 116-31.8 140.6-51.4 34.1 11.1 71.3 17.4 107.4 17.4 141.4 0 256-93.1 256-208S397.4 32 256 32z"/></svg>
            <span class="channel-label">Web</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Product mockup -->
    <InboxMockup />

    <div class="h-12 sm:h-16"></div>

    <!-- Stats bar -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-12 fade-in-up text-center max-w-4xl lg:mx-auto hero-stats">
      <div>
        <div class="font-display text-4xl sm:text-5xl font-bold tracking-tight">24/7</div>
        <div class="mono-label mt-2">Always On</div>
      </div>
      <div>
        <div class="font-display text-4xl sm:text-5xl font-bold tracking-tight">Zero</div>
        <div class="mono-label mt-2">Leads Missed</div>
      </div>
      <div>
        <div class="font-display text-4xl sm:text-5xl font-bold tracking-tight">Every</div>
        <div class="mono-label mt-2">Channel Connected</div>
      </div>
      <div>
        <div class="font-display text-4xl sm:text-5xl font-bold tracking-tight">Smart</div>
        <div class="mono-label mt-2">Agentic Workflow</div>
      </div>
    </div>
  </div>

  <!-- Bottom gradient fade into next section -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black to-transparent z-10 pointer-events-none"></div>
</section>

<style>
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    will-change: transform;
  }

  .hero-canvas :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.15) 50%,
      rgba(0, 0, 0, 0.5) 100%
    );
    pointer-events: none;
  }

  .hero-headline {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: 2rem;
  }

  .hero-stats {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 2rem 1.5rem;
  }

  .channel-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
  }

  .channel-icon:hover {
    color: rgba(255,255,255,0.9);
  }

  .channel-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
</style>

<script>
  // Dynamic import keeps Three.js (~122KB gzip) out of the critical rendering path
  const container = document.getElementById('hero-canvas-container');
  if (container) {
    requestAnimationFrame(() => {
      import('../scripts/hero-scene').then(({ initHeroScene }) => {
        initHeroScene(container);
      });
    });
  }
</script>
