---
const steps = [
  { title: 'Connect a channel', desc: 'Add the Replaid widget to your website, or connect an Instagram Business or Creator account, a Facebook Page, or a Telegram bot.' },
  { title: 'Connect your agent', desc: 'Copy your MCP URL from Replaid and authorize a compatible client. Use an agent token for REST.' },
  { title: 'Set permissions', desc: 'Choose the actions your agent can use. Keep sending disabled while you test with drafts.' },
  { title: 'Test a conversation', desc: 'Send a new message through your widget or from another account. Ask your agent for a draft, then inspect it and the action log.' },
];
---

<section id="how-it-works" class="py-16 sm:py-24 px-6">
  <div class="mx-auto max-w-7xl">
    <h2 class="text-display-sm max-w-2xl">From a connected channel to your first draft.</h2>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-12">
      {steps.map((step, index) => (
        <li class="border-t border-overlay/20 pt-5">
          <span class="text-fg font-display text-3xl" aria-hidden="true">0{index + 1}</span>
          <h3 class="text-xl mt-6 mb-3">{step.title}</h3>
          <p class="text-ink-200 leading-relaxed">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
