---
import ChannelIcon from './ChannelIcon.astro';
---

<section id="demo" class="px-6 pb-16 sm:pb-24" aria-labelledby="demo-heading">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
      <h2 id="demo-heading" class="text-2xl sm:text-3xl">One message. A clear next action.</h2>
      <p class="text-sm text-ink-200">Interactive example · fictional conversation</p>
    </div>
    <div class="demo-window">
      <div class="demo-toolbar">
        <span class="font-display font-bold text-lg">Replaid<span class="text-accent">.</span></span>
        <span class="text-sm text-ink-200">Conversation workspace</span>
      </div>
      <div class="grid lg:grid-cols-[1.25fr_1fr]">
        <div class="demo-conversation">
          <div class="flex items-center gap-3 pb-6 border-b border-overlay/10">
            <span class="avatar" aria-hidden="true">JL</span>
            <div>
              <h3 class="font-sans font-semibold text-base">Jamie Lee</h3>
              <p class="flex items-center gap-1.5 text-xs text-ink-200 mt-1"><ChannelIcon platform="instagram" size={14} />Instagram direct message</p>
            </div>
            <span class="ml-auto text-xs text-ink-200">Open</span>
          </div>
          <div class="py-7">
            <p class="text-xs text-ink-200 mb-2">Jamie · incoming message</p>
            <p class="message-bubble">Hi! Does the desk lamp come in green?</p>
          </div>
          <div class="reply-bubble" id="demo-reply" aria-live="polite" aria-atomic="true">
            <p class="reply-label" id="demo-reply-label">Draft · not sent</p>
            <p id="demo-reply-text" class="text-sm sm:text-base leading-relaxed mt-3">Yes, the desk lamp comes in green. Would you like the product link?</p>
            <p id="demo-reply-note" class="text-xs text-ink-200 mt-4">Saved in Replaid. The customer has not received this reply.</p>
          </div>
          <p class="text-xs text-ink-200 mt-5 leading-relaxed">The agent uses its own product information to write the answer.</p>
        </div>
        <div class="demo-agent">
          <h3 class="text-lg">Your agent's task</h3>
          <blockquote id="demo-task" class="text-ink-100 leading-relaxed text-sm mt-3 mb-6">“Find unanswered Instagram messages. Draft replies to product questions and flag anything that needs my attention.”</blockquote>
          <div class="flex flex-wrap gap-2 mb-6" role="group" aria-label="Choose an example action" id="demo-controls" hidden>
            <button type="button" class="demo-choice" data-demo-action="draft" aria-pressed="true" aria-controls="demo-reply demo-log">Draft reply</button>
            <button type="button" class="demo-choice" data-demo-action="send" aria-pressed="false" aria-controls="demo-reply demo-log">Permitted reply</button>
            <button type="button" class="demo-choice" data-demo-action="handoff" aria-pressed="false" aria-controls="demo-reply demo-log">Human handoff</button>
          </div>
          <h3 class="text-sm font-sans font-semibold mb-4">Action log</h3>
          <ol class="action-log" id="demo-log" aria-live="polite" aria-atomic="true">
            <li><span class="log-mark" aria-hidden="true">✓</span><div><strong>Context read</strong><p>Conversation and contact loaded.</p></div></li>
            <li><span class="log-mark" aria-hidden="true">✓</span><div><strong id="demo-policy-title">Draft permitted</strong><p id="demo-policy-detail">Creating drafts is enabled for this team.</p></div></li>
            <li><span class="log-mark" aria-hidden="true">✓</span><div><strong id="demo-result-title">Draft saved</strong><p id="demo-result-detail">No message sent to Instagram.</p></div></li>
          </ol>
          <p class="text-xs text-ink-200 leading-relaxed mt-7">This example does not connect to an account or send messages.</p>
          <noscript><p class="text-sm text-ink-200 mt-4">This example shows a saved draft. With permission, the agent can also send a reply or hand the conversation to a person.</p></noscript>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo-window { border: 1px solid rgba(var(--overlay), .18); border-radius: 16px; overflow: hidden; background: rgb(var(--ink-900)); }
  .demo-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.5rem; border-bottom: 1px solid rgba(var(--overlay), .12); }
  .demo-conversation, .demo-agent { padding: 1.5rem; min-width: 0; }
  .demo-conversation { background: rgb(var(--ink-950)); }
  .demo-agent { border-top: 1px solid rgba(var(--overlay), .12); }
  .avatar { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(var(--overlay), .08); font-size: .8rem; }
  .message-bubble { background: rgb(var(--ink-700)); border-radius: 0 12px 12px; padding: 1rem 1.25rem; max-width: 85%; font-size: .95rem; }
  .reply-bubble { padding: 1.25rem; border: 1px dashed rgba(var(--overlay), .35); border-radius: 12px 0 12px 12px; margin-left: 1.5rem; min-height: 172px; }
  .reply-bubble[data-state="send"] { border: 1px solid rgba(var(--accent-rgb), .6); background: rgba(var(--accent-rgb), .06); }
  .reply-bubble[data-state="handoff"] { border-style: solid; background: rgba(var(--overlay), .03); }
  .reply-label { font-size: .75rem; font-weight: 600; color: rgb(var(--ink-100)); }
  .demo-choice { font-size: .75rem; padding: .65rem .85rem; border: 1px solid rgba(var(--overlay), .2); border-radius: 6px; color: rgb(var(--ink-100)); }
  .demo-choice[aria-pressed="true"] { color: #000; background: #93e85f; border-color: #93e85f; }
  .demo-choice:hover { border-color: rgb(var(--fg)); }
  .action-log { display: grid; gap: 1.2rem; }
  .action-log li { display: flex; gap: .75rem; align-items: flex-start; }
  .action-log strong { font-size: .85rem; font-weight: 600; }
  .action-log p { font-size: .8rem; color: rgb(var(--ink-200)); margin-top: .25rem; line-height: 1.5; }
  .log-mark { color: rgb(var(--fg)); border: 1px solid rgba(var(--accent-rgb), .5); border-radius: 50%; width: 22px; height: 22px; display: grid; place-items: center; font-size: .7rem; flex-shrink: 0; margin-top: .1rem; }
  @media (min-width: 1024px) { .demo-conversation, .demo-agent { padding: 2rem 2.5rem; } .demo-agent { border-top: none; border-left: 1px solid rgba(var(--overlay), .12); } }
  @media (max-width: 400px) { .demo-toolbar { flex-direction: column; align-items: flex-start; gap: .25rem; } .reply-bubble { margin-left: 0; } }
</style>

<script>
  const examples = {
    draft: {
      task: '“Find unanswered Instagram messages. Draft replies to product questions and flag anything that needs my attention.”',
      label: 'Draft · not sent',
      text: 'Yes, the desk lamp comes in green. Would you like the product link?',
      note: 'Saved in Replaid. The customer has not received this reply.',
      policyTitle: 'Draft permitted',
      policyDetail: 'Creating drafts is enabled for this team.',
      resultTitle: 'Draft saved',
      resultDetail: 'No message sent to Instagram.',
    },
    send: {
      task: '“Answer Jamie’s product question using my catalog. Send the reply only if the team policy permits it.”',
      label: 'Reply · sent in this example',
      text: 'Yes, the desk lamp comes in green. Would you like the product link?',
      note: 'In this example, the customer receives the permitted reply.',
      policyTitle: 'Reply permitted',
      policyDetail: 'Sending is enabled and the action passes the team policy checks.',
      resultTitle: 'Reply sent',
      resultDetail: 'The send result is recorded in the action log.',
    },
    handoff: {
      task: '“If you cannot confirm product availability, flag Jamie’s conversation for a person and pause automation.”',
      label: 'Needs a person · automation paused',
      text: 'Please check product availability before replying to Jamie.',
      note: 'A team member can handle this conversation in the native channel.',
      policyTitle: 'Handoff permitted',
      policyDetail: 'Escalation is enabled for this team.',
      resultTitle: 'Conversation escalated',
      resultDetail: 'Automation is paused and the handoff is recorded.',
    },
  };
  const fields = {
    task: 'demo-task', label: 'demo-reply-label', text: 'demo-reply-text', note: 'demo-reply-note',
    policyTitle: 'demo-policy-title', policyDetail: 'demo-policy-detail',
    resultTitle: 'demo-result-title', resultDetail: 'demo-result-detail',
  };
  const controls = document.getElementById('demo-controls');
  const reply = document.getElementById('demo-reply');
  if (controls && reply) {
    const buttons = controls.querySelectorAll<HTMLButtonElement>('[data-demo-action]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.demoAction as keyof typeof examples;
        const example = examples[action];
        if (!example) return;
        for (const [key, id] of Object.entries(fields)) {
          const element = document.getElementById(id);
          if (element) element.textContent = example[key as keyof typeof example];
        }
        reply.dataset.state = action;
        buttons.forEach((choice) => choice.setAttribute('aria-pressed', String(choice === button)));
      });
    });
    controls.hidden = false;
  }
</script>
