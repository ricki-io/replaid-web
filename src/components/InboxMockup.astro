---
// Stylized fake inbox UI — visual product demo
import ChannelIcon from './ChannelIcon.astro';

const platforms = ['instagram', 'whatsapp', 'messenger', 'telegram', 'web'] as const;

const conversations = [
  { platform: 'instagram' as const, name: 'Sarah M.', message: 'Hey! I saw your post about the new collection, how can I order?', time: '2m', unread: true, ai: true },
  { platform: 'whatsapp' as const, name: 'James K.', message: 'What are your business hours?', time: '5m', unread: true, ai: true },
  { platform: 'messenger' as const, name: 'Lisa R.', message: 'Can I get a quote for 500 units?', time: '12m', unread: false, ai: false },
  { platform: 'telegram' as const, name: 'David P.', message: 'Thanks for the quick reply!', time: '1h', unread: false, ai: false },
  { platform: 'instagram' as const, name: 'Emma W.', message: 'Do you ship internationally?', time: '2h', unread: false, ai: false },
];

const sidebarBadges: Record<string, number | undefined> = { instagram: 2, whatsapp: 1 };
---

<div class="inbox-mockup fade-in-up">
  <!-- Window chrome -->
  <div class="inbox-chrome">
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-overlay/10"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-overlay/10"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-overlay/10"></span>
    </div>
    <span class="font-mono text-[10px] text-ink-300 tracking-wider uppercase">Replaid Inbox</span>
    <div class="w-16"></div>
  </div>

  <div class="inbox-body">
    <!-- Sidebar -->
    <div class="inbox-sidebar">
      <div class="flex flex-col gap-3 p-3">
        {platforms.map((p, i) => (
          <div class:list={['sidebar-icon', { active: i === 0 }]} aria-label={p}>
            <ChannelIcon platform={p} size={16} />
            {sidebarBadges[p] && <span class="sidebar-badge">{sidebarBadges[p]}</span>}
          </div>
        ))}
      </div>
    </div>

    <!-- Conversation list -->
    <div class="inbox-list">
      <div class="p-3 border-b border-overlay/5">
        <div class="flex items-center gap-2 px-2 py-1.5 rounded bg-overlay/5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-300" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
          <span class="text-xs text-ink-300">Search conversations...</span>
        </div>
      </div>
      {conversations.map((c, i) => (
        <div class:list={['conv-item', { active: i === 0 }]}>
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="conv-avatar">
              <ChannelIcon platform={c.platform} size={10} />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class:list={['text-xs font-medium truncate', c.unread ? 'text-fg' : 'text-ink-200']}>{c.name}</span>
                <span class="text-[10px] text-ink-300 shrink-0">{c.time}</span>
              </div>
              <p class:list={['text-[11px] truncate mt-0.5', c.unread ? 'text-ink-100' : 'text-ink-300']}>{c.message}</p>
            </div>
          </div>
          {c.unread && <div class="conv-unread-dot"></div>}
          {c.ai && (
            <div class="conv-ai-badge">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 4l7.5 13h-15L12 6z"/></svg>
              AI
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Chat panel -->
    <div class="inbox-chat">
      <!-- Chat header -->
      <div class="chat-header">
        <div class="flex items-center gap-2">
          <div class="conv-avatar">
            <ChannelIcon platform="instagram" size={10} />
          </div>
          <div>
            <div class="text-xs font-medium text-fg">Sarah M.</div>
            <div class="text-[10px] text-ink-300">Instagram · Direct Message</div>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="chat-tag tag-lead">Lead</span>
          <span class="chat-tag tag-hot">Hot</span>
        </div>
      </div>

      <!-- Messages -->
      <div class="chat-messages">
        <div class="chat-bubble incoming">
          <p>Hey! I saw your post about the new collection, how can I order? 😍</p>
          <span class="chat-time">2m ago</span>
        </div>

        <div class="chat-ai-divider">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3v2h-2V3h2zm-2 16v2h2v-2h-2zm9-9v2h-2v-2h2zM5 11v2H3v-2h2zm14.07-5.66l-1.41 1.41-1.42-1.41 1.42-1.42 1.41 1.42zM7.76 18.25l-1.41 1.41-1.42-1.41 1.42-1.42 1.41 1.42zm10.49 0l1.41 1.41-1.41 1.42-1.42-1.42 1.42-1.41zM5.35 5.34L6.76 6.76 5.35 8.17 3.93 6.76l1.42-1.42zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z"/></svg>
          <span>Replaid AI replied</span>
        </div>

        <div class="chat-bubble outgoing">
          <p>Hi Sarah! Thanks for your interest! 🎉 Our new collection is available now. You can order directly through our website or I can help you right here. What items caught your eye?</p>
          <span class="chat-time flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><polyline points="20 6 9 17 4 12"/></svg>
            Sent · AI
          </span>
        </div>

        <div class="chat-bubble incoming">
          <p>The green jacket and the crossbody bag! Can I get both shipped to Tokyo?</p>
          <span class="chat-time">Just now</span>
        </div>
      </div>

      <!-- AI typing indicator -->
      <div class="chat-typing">
        <div class="typing-dots">
          <span></span><span></span><span></span>
        </div>
        <span class="text-[10px] text-accent">AI is drafting a reply...</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Dark scrollbars */
  .inbox-mockup *::-webkit-scrollbar {
    width: 4px;
  }

  .inbox-mockup *::-webkit-scrollbar-track {
    background: transparent;
  }

  .inbox-mockup *::-webkit-scrollbar-thumb {
    background: rgba(var(--overlay),0.1);
    border-radius: 4px;
  }

  .inbox-mockup *::-webkit-scrollbar-thumb:hover {
    background: rgba(var(--overlay),0.2);
  }

  .inbox-mockup * {
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--overlay),0.1) transparent;
  }

  .inbox-mockup {
    max-width: 56rem;
    margin: 0 auto;
    border-radius: 12px;
    border: 1px solid rgba(var(--overlay),0.08);
    background: rgba(var(--surface),0.6);
    backdrop-filter: blur(20px);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(var(--overlay),0.03),
      0 20px 60px rgba(var(--surface),0.5),
      0 0 80px rgba(var(--accent-rgb),0.03);
  }

  .inbox-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid rgba(var(--overlay),0.06);
    background: rgba(var(--overlay),0.02);
  }

  .inbox-body {
    display: flex;
    min-height: 22rem;
  }

  /* Sidebar */
  .inbox-sidebar {
    width: 3.5rem;
    border-right: 1px solid rgba(var(--overlay),0.06);
    background: rgba(var(--overlay),0.01);
    flex-shrink: 0;
  }

  .sidebar-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    color: rgba(var(--overlay),0.35);
    transition: all 0.15s;
  }

  .sidebar-icon:hover,
  .sidebar-icon.active {
    background: rgba(var(--overlay),0.06);
    color: rgba(var(--overlay),0.85);
  }

  .sidebar-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgb(var(--accent-rgb));
    color: rgb(var(--ink-950));
    font-size: 9px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Conversation list */
  .inbox-list {
    width: 14rem;
    border-right: 1px solid rgba(var(--overlay),0.06);
    overflow-y: auto;
    flex-shrink: 0;
    display: none;
  }

  @media (min-width: 640px) {
    .inbox-list {
      display: block;
    }
  }

  .conv-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid rgba(var(--overlay),0.04);
    cursor: default;
    transition: background 0.15s;
  }

  .conv-item:hover,
  .conv-item.active {
    background: rgba(var(--overlay),0.04);
  }

  .conv-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: rgba(var(--overlay),0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: rgba(var(--overlay),0.5);
  }

  .conv-unread-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--accent-rgb));
    align-self: flex-end;
    flex-shrink: 0;
  }

  .conv-ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 9px;
    font-weight: 600;
    color: rgb(var(--accent-rgb));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-self: flex-start;
  }

  /* Chat panel */
  .inbox-chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid rgba(var(--overlay),0.06);
    background: rgba(var(--overlay),0.01);
  }

  .chat-tag {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .tag-lead {
    background: rgba(var(--accent-rgb),0.15);
    color: rgb(var(--accent-rgb));
  }

  .tag-hot {
    background: rgba(255,140,50,0.15);
    color: #ff8c32;
  }

  .chat-messages {
    flex: 1;
    padding: 0.75rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chat-bubble {
    max-width: 85%;
    padding: 0.5rem 0.75rem;
    border-radius: 12px;
    font-size: 12px;
    line-height: 1.5;
  }

  .chat-bubble.incoming {
    background: rgba(var(--overlay),0.06);
    color: rgba(var(--overlay),0.85);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }

  .chat-bubble.outgoing {
    background: rgba(var(--accent-rgb),0.1);
    border: 1px solid rgba(var(--accent-rgb),0.15);
    color: rgba(var(--overlay),0.9);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
  }

  .chat-time {
    display: block;
    font-size: 9px;
    color: rgba(var(--overlay),0.3);
    margin-top: 4px;
  }

  .chat-ai-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 4px 0;
    font-size: 10px;
    color: rgb(var(--accent-rgb));
    opacity: 0.7;
  }

  .chat-typing {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid rgba(var(--overlay),0.04);
  }

  .typing-dots {
    display: flex;
    gap: 3px;
  }

  .typing-dots span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgb(var(--accent-rgb));
    animation: blink 1.4s infinite both;
  }

  .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes blink {
    0%, 80%, 100% { opacity: 0.2; }
    40% { opacity: 1; }
  }
</style>
