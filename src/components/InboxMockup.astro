---
// Stylized fake inbox UI — visual product demo
const conversations = [
  { platform: 'instagram', name: 'Sarah M.', message: 'Hey! I saw your post about the new collection, how can I order?', time: '2m', unread: true, ai: true },
  { platform: 'whatsapp', name: 'James K.', message: 'What are your business hours?', time: '5m', unread: true, ai: true },
  { platform: 'messenger', name: 'Lisa R.', message: 'Can I get a quote for 500 units?', time: '12m', unread: false, ai: false },
  { platform: 'telegram', name: 'David P.', message: 'Thanks for the quick reply!', time: '1h', unread: false, ai: false },
  { platform: 'instagram', name: 'Emma W.', message: 'Do you ship internationally?', time: '2h', unread: false, ai: false },
];
---

<div class="inbox-mockup fade-in-up">
  <!-- Window chrome -->
  <div class="inbox-chrome">
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
    </div>
    <span class="font-mono text-[10px] text-ink-300 tracking-wider uppercase">Replaid Inbox</span>
    <div class="w-16"></div>
  </div>

  <div class="inbox-body">
    <!-- Sidebar -->
    <div class="inbox-sidebar">
      <div class="flex flex-col gap-3 p-3">
        <!-- Instagram -->
        <button class="sidebar-icon active" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8z"/></svg>
          <span class="sidebar-badge">2</span>
        </button>
        <!-- WhatsApp -->
        <button class="sidebar-icon" aria-label="WhatsApp">
          <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
          <span class="sidebar-badge">1</span>
        </button>
        <!-- Messenger -->
        <button class="sidebar-icon" aria-label="Messenger">
          <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor"><path d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64h98.2V334.2H109.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H255V480H384c35.3 0 64-28.7 64-64V96c0-35.3-28.7-64-64-64H64z"/></svg>
        </button>
        <!-- Telegram -->
        <button class="sidebar-icon" aria-label="Telegram">
          <svg width="16" height="16" viewBox="0 0 496 512" fill="currentColor"><path d="M248 8C111 8 0 119 0 256S111 504 248 504 496 393 496 256 385 8 248 8zM363 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5q-3.3 .7-104.6 69.1-14.8 10.2-26.9 9.9c-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3q.8-6.7 18.5-13.7 108.4-47.2 144.6-62.3c68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9a10.5 10.5 0 0 1 3.5 6.7A43.8 43.8 0 0 1 363 176.7z"/></svg>
        </button>
        <!-- Web Widget -->
        <button class="sidebar-icon" aria-label="Web Widget">
          <svg width="16" height="16" viewBox="0 0 512 512" fill="currentColor"><path d="M256 32C114.6 32 0 125.1 0 240c0 49.6 21.4 95 57 130.7C44.5 421.1 2.7 466 2.2 466.5c-2.2 2.3-2.8 5.7-1.5 8.7S4.8 480 8 480c66.3 0 116-31.8 140.6-51.4 34.1 11.1 71.3 17.4 107.4 17.4 141.4 0 256-93.1 256-208S397.4 32 256 32z"/></svg>
        </button>
      </div>
    </div>

    <!-- Conversation list -->
    <div class="inbox-list">
      <div class="p-3 border-b border-white/5">
        <div class="flex items-center gap-2 px-2 py-1.5 rounded bg-white/5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-300" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
          <span class="text-xs text-ink-300">Search conversations...</span>
        </div>
      </div>
      {conversations.map((c, i) => (
        <div class:list={['conv-item', { active: i === 0 }]}>
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="conv-avatar">
              {c.platform === 'instagram' && (
                <svg width="10" height="10" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8z"/></svg>
              )}
              {c.platform === 'whatsapp' && (
                <svg width="10" height="10" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
              )}
              {c.platform === 'messenger' && (
                <svg width="10" height="10" viewBox="0 0 448 512" fill="currentColor"><path d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64h98.2V334.2H109.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H255V480H384c35.3 0 64-28.7 64-64V96c0-35.3-28.7-64-64-64H64z"/></svg>
              )}
              {c.platform === 'telegram' && (
                <svg width="10" height="10" viewBox="0 0 496 512" fill="currentColor"><path d="M248 8C111 8 0 119 0 256S111 504 248 504 496 393 496 256 385 8 248 8zM363 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5q-3.3 .7-104.6 69.1-14.8 10.2-26.9 9.9c-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3q.8-6.7 18.5-13.7 108.4-47.2 144.6-62.3c68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9a10.5 10.5 0 0 1 3.5 6.7A43.8 43.8 0 0 1 363 176.7z"/></svg>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class:list={['text-xs font-medium truncate', c.unread ? 'text-white' : 'text-ink-200']}>{c.name}</span>
                <span class="text-[10px] text-ink-300 shrink-0">{c.time}</span>
              </div>
              <p class:list={['text-[11px] truncate mt-0.5', c.unread ? 'text-ink-100' : 'text-ink-300']}>{c.message}</p>
            </div>
          </div>
          {c.unread && <div class="conv-unread-dot"></div>}
          {c.ai && (
            <div class="conv-ai-badge">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 4l7.5 13h-15L12 6z"/></svg>
              AI
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Chat panel -->
    <div class="inbox-chat">
      <!-- Chat header -->
      <div class="chat-header">
        <div class="flex items-center gap-2">
          <div class="conv-avatar">
            <svg width="10" height="10" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8z"/></svg>
          </div>
          <div>
            <div class="text-xs font-medium text-white">Sarah M.</div>
            <div class="text-[10px] text-ink-300">Instagram · Direct Message</div>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="chat-tag tag-lead">Lead</span>
          <span class="chat-tag tag-hot">Hot</span>
        </div>
      </div>

      <!-- Messages -->
      <div class="chat-messages">
        <div class="chat-bubble incoming">
          <p>Hey! I saw your post about the new collection, how can I order? 😍</p>
          <span class="chat-time">2m ago</span>
        </div>

        <div class="chat-ai-divider">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3v2h-2V3h2zm-2 16v2h2v-2h-2zm9-9v2h-2v-2h2zM5 11v2H3v-2h2zm14.07-5.66l-1.41 1.41-1.42-1.41 1.42-1.42 1.41 1.42zM7.76 18.25l-1.41 1.41-1.42-1.41 1.42-1.42 1.41 1.42zm10.49 0l1.41 1.41-1.41 1.42-1.42-1.42 1.42-1.41zM5.35 5.34L6.76 6.76 5.35 8.17 3.93 6.76l1.42-1.42zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z"/></svg>
          <span>Replaid AI replied</span>
        </div>

        <div class="chat-bubble outgoing">
          <p>Hi Sarah! Thanks for your interest! 🎉 Our new collection is available now. You can order directly through our website or I can help you right here. What items caught your eye?</p>
          <span class="chat-time flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><polyline points="20 6 9 17 4 12"/></svg>
            Sent · AI
          </span>
        </div>

        <div class="chat-bubble incoming">
          <p>The green jacket and the crossbody bag! Can I get both shipped to Tokyo?</p>
          <span class="chat-time">Just now</span>
        </div>
      </div>

      <!-- AI typing indicator -->
      <div class="chat-typing">
        <div class="typing-dots">
          <span></span><span></span><span></span>
        </div>
        <span class="text-[10px] text-accent">AI is drafting a reply...</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Dark scrollbars */
  .inbox-mockup *::-webkit-scrollbar {
    width: 4px;
  }

  .inbox-mockup *::-webkit-scrollbar-track {
    background: transparent;
  }

  .inbox-mockup *::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
  }

  .inbox-mockup *::-webkit-scrollbar-thumb:hover {
    background: rgba(255,255,255,0.2);
  }

  .inbox-mockup * {
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
  }

  .inbox-mockup {
    max-width: 56rem;
    margin: 0 auto;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(20px);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.03),
      0 20px 60px rgba(0,0,0,0.5),
      0 0 80px rgba(147,232,95,0.03);
  }

  .inbox-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.02);
  }

  .inbox-body {
    display: flex;
    height: 22rem;
  }

  /* Sidebar */
  .inbox-sidebar {
    width: 3.5rem;
    border-right: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.01);
    flex-shrink: 0;
  }

  .sidebar-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    color: rgba(255,255,255,0.35);
    transition: all 0.15s;
    cursor: default;
  }

  .sidebar-icon:hover,
  .sidebar-icon.active {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.85);
  }

  .sidebar-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #93e85f;
    color: #000;
    font-size: 9px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Conversation list */
  .inbox-list {
    width: 14rem;
    border-right: 1px solid rgba(255,255,255,0.06);
    overflow-y: auto;
    flex-shrink: 0;
    display: none;
  }

  @media (min-width: 640px) {
    .inbox-list {
      display: block;
    }
  }

  .conv-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    cursor: default;
    transition: background 0.15s;
  }

  .conv-item:hover,
  .conv-item.active {
    background: rgba(255,255,255,0.04);
  }

  .conv-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: rgba(255,255,255,0.5);
  }

  .conv-unread-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #93e85f;
    align-self: flex-end;
    flex-shrink: 0;
  }

  .conv-ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 9px;
    font-weight: 600;
    color: #93e85f;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-self: flex-start;
  }

  /* Chat panel */
  .inbox-chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.01);
  }

  .chat-tag {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .tag-lead {
    background: rgba(147,232,95,0.15);
    color: #93e85f;
  }

  .tag-hot {
    background: rgba(255,140,50,0.15);
    color: #ff8c32;
  }

  .chat-messages {
    flex: 1;
    padding: 0.75rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chat-bubble {
    max-width: 85%;
    padding: 0.5rem 0.75rem;
    border-radius: 12px;
    font-size: 12px;
    line-height: 1.5;
  }

  .chat-bubble.incoming {
