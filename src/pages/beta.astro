---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import { betaAccess } from '../components/product-copy';
import '../styles/landing.css';
import '../styles/contact.css';
import '../styles/beta.css';

const channels = ['WhatsApp', 'Replaid widget', 'Instagram', 'Messenger', 'Telegram', 'Not sure yet'];
const agents = ['ChatGPT', 'Claude', 'Codex', 'Hermes Agent', 'Another agent', 'Not decided yet'];
---
<Layout title="Request Beta Access | Replaid" description="Tell us how you want to use Replaid with your AI agent. Request beta access with your email, use case, and customer channels.">
  <div class="sky-landing contact-page beta-page">
    <SkyHeader />
    <main id="main" class="contact-main">
      <div class="contact-intro">
        <p class="contact-label">Replaid beta</p>
        <h1>Request<br /><span class="hero-highlight">beta access.</span></h1>
        <p class="contact-description">Tell us how you’d use Replaid. We’ll review your request and email you about access.</p>
        <p class="beta-access-note">Access is by invitation. Requesting access is free.</p>
        <a class="contact-email beta-login" href="https://app.replaid.pro/login">Already have access? Log in</a>
      </div>
      <section class="contact-panel" aria-label="Beta access request">
        <form id="beta-access-form" action="https://api.web3forms.com/submit" method="POST">
          <div class="contact-form-heading"><h2>What would you like to try?</h2><p>A few details help us understand your use case.</p></div>
          <input type="hidden" name="access_key" value="a9640491-09a2-43e9-8125-7c2ea847b64a" />
          <input type="hidden" name="subject" value="Beta access request — Replaid" />
          <input type="hidden" name="from_name" value="Replaid beta access" />
          <input type="hidden" name="redirect" value="https://replaid.pro/beta/?success=true" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" aria-hidden="true" />
          <div class="contact-field">
            <label for="beta-email">Email address</label>
            <input id="beta-email" type="email" name="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" />
          </div>
          <div class="contact-field">
            <label for="beta-use-case">What would you like your agent to help with?</label>
            <textarea id="beta-use-case" name="message" rows="3" required maxlength="2000" placeholder="For example, draft answers to customer questions about my online store."></textarea>
          </div>
          <div class="contact-field">
            <fieldset class="beta-choices" aria-describedby="beta-channel-hint">
              <legend>Which channels would you connect?</legend>
              <details class="beta-select" id="beta-channel-select">
                <summary><span class="sr-only">Channels: </span><span data-selected-value>Choose channels</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                <div class="beta-select-menu">
                  <p id="beta-channel-hint">Select one or more.</p>
                  <div class="beta-select-options">
                    {channels.map(channel => <label class="beta-select-option"><input type="checkbox" name="channel" value={channel} /><span>{channel}</span></label>)}
                  </div>
                </div>
              </details>
            </fieldset>
          </div>
          <div class="contact-field">
            <fieldset class="beta-choices" id="beta-agent-field">
              <legend>Which agent would you use? <span>(optional)</span></legend>
              <details class="beta-select beta-agent-select" id="beta-agent-select">
                <summary><span class="sr-only">Agent: </span><span data-selected-value>Choose an agent</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                <div class="beta-select-menu">
                  <div class="beta-select-options">
                    {['', ...agents].map(agent => <label class="beta-select-option"><input type="radio" name="agent" value={agent} checked={agent === ''} /><span>{agent || 'Choose an agent'}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></label>)}
                  </div>
                </div>
              </details>
            </fieldset>
          </div>
          <div class="contact-submit">
            <div class="h-captcha" data-captcha="true" data-theme="light" data-size="compact"></div>
            <div class="contact-submit-copy">
              <p>We use these details to review your request and contact you about beta access. <a href="/privacy/">Privacy policy</a></p>
              <p id="beta-form-error" class="beta-form-error" role="alert" tabindex="-1" hidden></p>
              <button class="sky-button" type="submit">{betaAccess.label}</button>
            </div>
          </div>
          <p class="contact-form-fallback">Prefer email? <a href="mailto:hi@replaid.pro?subject=Beta%20access%20request">hi@replaid.pro</a></p>
        </form>
        <div id="beta-success" class="contact-success" role="status" aria-live="polite" hidden>
          <span class="contact-success-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m5 12 4 4L19 6" /></svg></span>
          <h2 tabindex="-1">Request received.</h2>
          <p>We’ll review your use case and email you about beta access.</p>
          <a class="sky-button" href="/docs/connect-your-agent/">Explore the setup guide</a>
          <a class="contact-another" href="/">Back to homepage</a>
        </div>
      </section>
    </main>
    <SkyFooter />
  </div>
  <script src="https://web3forms.com/client/script.js" async defer></script>
  <script>
    import { initBetaAccessForm, initBetaSelect } from '../components/beta-access-form.mjs';
    const form = document.querySelector<HTMLFormElement>('#beta-access-form')!;
    const success = document.querySelector<HTMLElement>('#beta-success')!;
    const status = document.querySelector<HTMLElement>('#beta-form-error')!;
    if (new URLSearchParams(location.search).get('success') === 'true') {
      form.hidden = true;
      success.hidden = false;
    } else {
      initBetaSelect(form.querySelector<HTMLDetailsElement>('#beta-channel-select')!);
      initBetaSelect(form.querySelector<HTMLDetailsElement>('#beta-agent-select')!, { placeholder: 'Choose an agent', closeOnSelect: true });
      initBetaAccessForm({ form, success, status });
    }
  </script>
</Layout>
