---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import '../styles/landing.css';
import '../styles/not-found.css';
---

<Layout noindex title="404 — Page not found | Replaid" description="We could not find this page. Return to Replaid or open the connection guide.">
  <div class="sky-landing error-page">
    <SkyHeader />
    <main id="main">
      <section class="error-content" aria-labelledby="error-heading">
        <div class="error-scene" aria-hidden="true">
          <span class="error-code">404</span>
        </div>
        <p class="error-label">404 / Page not found</p>
        <h1 id="error-heading">We couldn’t find<br /><span class="hero-highlight">this page.</span></h1>
        <p class="error-description">The link may have changed, or the address may be incorrect. Let’s get you back to the right place.</p>
        <div class="error-actions">
          <a class="sky-button" href="/">Back to homepage</a>
          <a class="error-guide" href="/docs/connect-your-agent/">Open connection guide<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
        </div>
        <p class="error-help">Still need a hand? <a href="/contact/">Contact us</a></p>
      </section>
    </main>
    <SkyFooter />
  </div>
</Layout>
