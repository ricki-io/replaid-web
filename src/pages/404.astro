---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import '../styles/global.css';
import '../styles/landing.css';
---

<Layout title="404 — Page not found | Replaid" description="We could not find this page. Return to Replaid or open the connection guide." forceLight>
  <div class="sky-landing error-page">
    <SkyHeader />
    <main id="main">
      <section class="error-content" aria-labelledby="error-heading">
        <div class="error-scene" aria-hidden="true">
          <svg class="error-lines" width="540" height="160" viewBox="0 0 540 160" fill="none"><path d="M0 97c74 0 78-45 150-45h41M349 108h40c67 0 77-45 151-45" stroke="#b6d8ee" stroke-width="1.4" stroke-linecap="round"/><circle cx="191" cy="52" r="3" fill="#a2c9e5"/><circle cx="349" cy="108" r="3" fill="#a2c9e5"/></svg>
          <span class="error-digit error-digit-left">4</span>
          <span class="error-zero">0</span>
          <span class="error-digit error-digit-right">4</span>
        </div>
        <p class="error-label">404 / Page not found</p>
        <h1 id="error-heading">We couldn’t find<br /><span class="hero-highlight">this page.</span></h1>
        <p class="error-description">The link may have changed, or the address may be incorrect. Let’s get you back to the right place.</p>
        <div class="error-actions">
          <a class="sky-button" href="/">Back to homepage</a>
          <a class="error-guide" href="/docs/connect-your-agent">Open connection guide<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
        </div>
        <p class="error-help">Still need a hand? <a href="/contact">Contact us</a></p>
      </section>
    </main>
    <SkyFooter />
  </div>
</Layout>

<style>
  .error-content { max-width: 860px; margin: 0 auto; padding: 48px 24px 74px; text-align: center; }
  .error-scene { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: center; gap: 28px; width: 100%; height: 200px; margin-bottom: 22px; }
  .error-scene::before { content: ''; position: absolute; z-index: -2; inset: -75px -70px -90px; background: url('/connector-sky-wisps.webp') center 58% / cover; mask-image: radial-gradient(ellipse 48% 46% at 50% 50%, #000 0%, transparent 100%); opacity: .65; }
  .error-lines { position: absolute; z-index: -1; top: 20px; left: 50%; width: min(540px, 115%); height: 160px; transform: translateX(-50%); mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent); }
  .error-digit { color: #688eaa; font-size: 122px; font-weight: 550; line-height: 1; letter-spacing: -.075em; }
  .error-digit-left { transform: translateY(-6px) rotate(-8deg); }
  .error-digit-right { transform: translateY(9px) rotate(8deg); }
  .error-zero { display: grid; place-items: center; width: 136px; height: 150px; border-radius: 42px; border: 1px solid #fff; background: linear-gradient(145deg, #ffffffed, #ffffffe0); box-shadow: inset 0 1px 3px #fff, 0 18px 40px #376d9421; color: #436c8b; font-size: 104px; font-weight: 450; line-height: 1; transform: rotate(-7deg); }
  .error-label { color: #64707f; font-size: 12px; }
  .error-content h1 { margin-top: 18px; font-size: clamp(38px, 4.6vw, 54px); font-weight: 600; letter-spacing: -.05em; line-height: 1.08; }
  .error-description { max-width: 415px; margin: 22px auto 0; color: #64707f; font-size: 16px; line-height: 1.7; }
  .error-actions { display: flex; align-items: center; justify-content: center; gap: 24px; margin-top: 29px; }
  .error-guide { display: inline-flex; align-items: center; gap: 8px; color: #385267; font-size: 14px; font-weight: 550; }
  .error-guide svg { flex: none; }
  .error-guide:hover, .error-help a:hover { color: #0875d5; }
  .error-help { margin-top: 30px; color: #64707f; font-size: 12px; }
  .error-help a { color: #385267; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 700px) {
    .error-content { padding: 28px 20px 44px; }
    .error-scene { height: 174px; gap: 20px; margin-bottom: 20px; }
    .error-scene::before { inset: -40px -55px -65px; }
    .error-digit { font-size: 92px; }
    .error-zero { width: 110px; height: 122px; border-radius: 34px; font-size: 82px; }
    .error-lines { top: 5px; }
    .error-content h1 { font-size: 40px; }
    .error-description { font-size: 15px; max-width: 350px; }
    .error-actions { flex-direction: column; gap: 22px; margin-top: 26px; }
  }
  @media (max-width: 380px) {
    .error-scene { gap: 17px; }
    .error-digit { font-size: 76px; }
    .error-zero { width: 94px; height: 108px; font-size: 72px; border-radius: 30px; }
    .error-content h1 { font-size: 36px; }
  }
</style>
