---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import BlogMeta from '../components/BlogMeta.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import '../styles/landing.css';
import '../styles/blog.css';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await render(post);
const currentArticle = post.data.supersededBy ? await getEntry(post.data.supersededBy) : undefined;
if (post.data.historical && (!currentArticle || currentArticle.data.draft || currentArticle.data.historical)) {
  throw new Error(`Historical article ${post.id} must link to a published current article.`);
}
const contents = headings.filter(heading => heading.depth === 2);
const related = (await getCollection('blog', ({ id, data }) => !data.draft && !data.historical && id !== post.id))
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category) || b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id))
  .slice(0, 2);

const blogJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "author": {
      "@type": "Person",
      "name": post.data.author,
    },
    "datePublished": post.data.date.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.date).toISOString(),
    ...(post.data.image && { "image": new URL(post.data.image, 'https://replaid.pro').href }),
    "publisher": {
      "@type": "Organization",
      "name": "Replaid",
      "logo": { "@type": "ImageObject", "url": "https://replaid.pro/favicon.svg" }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://replaid.pro/${post.id}/`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://replaid.pro/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://replaid.pro/blog/" },
      { "@type": "ListItem", "position": 3, "name": post.data.title, "item": `https://replaid.pro/${post.id}/` }
    ]
  }
];
---

<Layout title={`${post.data.seoTitle ?? post.data.title} — Replaid Blog`} description={post.data.description} ogImage={post.data.image || "/og-image.png"} type="article" jsonLd={blogJsonLd}>
  <div class="sky-landing blog-page article-page">
    <SkyHeader />
    <main id="main" class="article-main">
      <article>
        <header class="article-header">
          <a class="article-back" href="/blog/"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m5-5-5 5 5 5" /></svg>All articles</a>
          <p class="blog-category">{post.data.category}</p>
          <h1>{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
          <div class="article-byline"><span class="article-author">By {post.data.author}</span><BlogMeta post={post} showPublished /></div>
        </header>

        {post.data.historical && currentArticle && <aside class="article-history" aria-labelledby="article-history-heading">
          <span class="blog-history-label">Historical article · {post.data.date.getUTCFullYear()} launch</span>
          <h2 id="article-history-heading">Replaid has changed since this was published.</h2>
          <p>This is the original launch announcement. Its features, channel availability, and promises describe the earlier product, not Replaid today. Replaid now connects customer messages to the AI agent you bring.</p>
          <a href={`/${currentArticle.id}/`}>Read what changed<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
        </aside>}

        {contents.length > 0 && <details class="article-mobile-contents">
          <summary>On this page<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
          <nav aria-label="Article sections"><ul>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
        </details>}

        <div class="article-layout">
          {contents.length > 0 && <aside class="article-sidebar"><nav class="article-contents" aria-label="On this page"><p>On this page</p><ul>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul><a class="article-back-top" href="#main">Back to top ↑</a></nav></aside>}
          <div class="article-prose"><Content /></div>
        </div>
      </article>

      {related.length > 0 && <section class="article-related" aria-labelledby="related-heading">
        <div class="article-related-heading"><h2 id="related-heading">Keep reading</h2><a href="/blog/">All articles<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a></div>
        <div class="blog-list">{related.map(relatedPost => <BlogPostCard post={relatedPost} />)}</div>
      </section>}
    </main>
    <SkyFooter />
  </div>
  <script>
    const contents = document.querySelector<HTMLDetailsElement>('.article-mobile-contents');
    contents?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { contents.open = false; }));
  </script>
</Layout>
