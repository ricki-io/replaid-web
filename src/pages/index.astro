---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { faqs } from '../components/faq-content';
import '../styles/global.css';
import '../styles/landing.css';

const description = 'Connect your AI agent to your customers. Replaid brings channel context, action permissions, and MCP or API access to the agent you already use.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Replaid',
    url: 'https://replaid.pro',
    logo: 'https://replaid.pro/favicon.svg',
    description,
    contactPoint: { '@type': 'ContactPoint', email: 'hi@replaid.pro', contactType: 'customer support' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Replaid',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description,
    offers: {
      '@type': 'Offer', name: 'Current supported operations', price: '0', priceCurrency: 'USD',
      description: 'Current supported operations are free. Future paid operations use prepaid credits. Agent provider costs are separate.',
      url: 'https://replaid.pro/#pricing',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question', name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---
<Layout title="Replaid — Connect your AI agent to your customers" description={description} jsonLd={jsonLd} forceLight>
  <main id="main" class="sky-landing">
    <Hero />
    <section id="how-it-works" class="sky-section agent-explanation" aria-labelledby="agent-heading">
      <div id="features">
        <h2 id="agent-heading">Your agent brings the intelligence.<br />Replaid makes the connection.</h2>
      </div>
      <p>Keep your knowledge and instructions in your agent.</p>
      <ol class="agent-flow">
        <li>
          <div class="flow-preview flow-context" aria-hidden="true">
            <div class="flow-message flow-message-back"><i></i><i></i></div>
            <div class="flow-message"><span class="flow-message-dot"></span><strong>New message</strong><i></i><i></i></div>
          </div>
          <h3><span class="flow-step">01</span>Receive context</h3>
          <p>Your agent gets the conversation, so it knows what the customer needs.</p>
        </li>
        <li>
          <div class="flow-preview flow-action" aria-hidden="true">
            <div class="flow-agent-mark"><svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1c1.5 6.5 4.5 9.5 11 11-6.5 1.5-9.5 4.5-11 11C10.5 16.5 7.5 13.5 1 12 7.5 10.5 10.5 7.5 12 1Z" /></svg></div>
            <div class="flow-request"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5-7 7 7 7M2 12h12a7 7 0 0 1 7 7" /></svg>Draft a reply</div>
          </div>
          <h3><span class="flow-step">02</span>Request an action</h3>
          <p>Your agent uses its knowledge and instructions to choose the next step.</p>
        </li>
        <li>
          <div class="flow-preview flow-rules" aria-hidden="true">
            <div class="flow-permissions">
              <div><span>Read messages</span><span class="flow-check">✓</span></div>
              <div><span>Create drafts</span><span class="flow-check">✓</span></div>
              <div><span>Send replies</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
            </div>
          </div>
          <h3><span class="flow-step">03</span>Apply your rules</h3>
          <p>Replaid checks permissions before it carries out the action. You stay in control.</p>
        </li>
      </ol>
    </section>
    <section id="connections" class="sky-section growth-section" aria-labelledby="growth-heading">
      <h2 id="growth-heading">One connection.<br />Room to grow.</h2>
      <div class="growth-copy">
        <p>Connect the channels you use today. Keep the same agent workflow as your setup grows.</p>
        <details class="connection-details">
          <summary>Explore available connections</summary>
          <ul class="connection-list">
            <li>Instagram <span>Business or Creator account</span></li>
            <li>Messenger <span>Facebook Page</span></li>
            <li>Telegram <span>Private messages to your bot</span></li>
            <li>WhatsApp <span>Planned</span></li>
            <li>TikTok <span>Planned</span></li>
          </ul>
          <p class="connection-note">Current connections support text messages and replies. Instagram also supports text comments. One active account per channel, per team. Previous messages are not imported.</p>
          <p class="connection-note">MCP and REST connect your agent. Automatic processing needs an external schedule or a webhook receiver that starts it. <a href="/get-started">Read the connection guide.</a></p>
        </details>
      </div>
    </section>
    <section class="sky-section sky-final-cta">
      <h2>Your agent. Connected.</h2>
      <a class="sky-button" href="https://app.replaid.pro/register">Connect your agent</a>
    </section>
    <section id="faq" class="sky-faq" aria-labelledby="faq-heading">
      <header class="sky-faq-heading">
        <span>FAQ</span>
        <h2 id="faq-heading">Questions before you connect?</h2>
      </header>
      <div class="sky-faq-list">
        {faqs.map(faq => (
          <details class="sky-faq-item" id={faq.q === 'What does Replaid cost?' ? 'pricing' : undefined}>
            <summary>
              <span>{faq.q}</span>
              <svg class="sky-faq-toggle" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12" /><path class="sky-faq-toggle-vertical" d="M10 4v12" /></svg>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
    <footer class="sky-footer">
      <div class="sky-footer-main">
        <div class="sky-footer-brand">
          <a class="sky-wordmark sky-nav-brand" href="/" aria-label="Replaid home"><img src="/favicon.svg" width="28" height="30" alt="" aria-hidden="true" /><span>Replaid</span></a>
          <p>A customer inbox for your AI agent.</p>
        </div>
        <nav aria-label="Product">
          <h3>Product</h3>
          <a href="/#features">Features</a>
          <a href="/#pricing">Pricing</a>
          <a href="/#faq">FAQ</a>
          <a href="/get-started">Docs</a>
        </nav>
        <nav aria-label="Company">
          <h3>Company</h3>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
          <a href="https://replaid.instatus.com/" target="_blank" rel="noopener noreferrer">Status</a>
        </nav>
        <nav aria-label="Legal">
          <h3>Legal</h3>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/cookies">Cookies</a>
        </nav>
      </div>
      <div class="sky-footer-bottom">© {new Date().getFullYear()} Replaid</div>
    </footer>
  </main>
</Layout>
<script>
  function revealDestination(hash: string) {
    if (hash !== '#pricing' && hash !== '#connections') return;
    const target = document.getElementById(hash.slice(1));
    const details = target instanceof HTMLDetailsElement ? target : target?.querySelector('details');
    if (details) details.open = true;
  }
  document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach(link => {
    link.addEventListener('click', () => {
      const url = new URL(link.href);
      if (url.pathname === location.pathname) revealDestination(url.hash);
    });
  });
  window.addEventListener('hashchange', () => revealDestination(location.hash));
  revealDestination(location.hash);
</script>
