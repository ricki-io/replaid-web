---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import { productCopy } from '../components/product-copy';
import '../styles/landing.css';
import '../styles/pricing.css';

const description = 'No subscription. Current Instagram, Messenger, Telegram, and Replaid widget actions are free. Prepaid USD credits cover future paid operations at provider cost plus 20%.';
const registerUrl = 'https://app.replaid.pro/register';
const getStartedUrl = '/get-started/';
const packages = [
  { amount: '$10', cents: 1000, detail: 'Prepaid USD balance', label: 'Small top-up' },
  { amount: '$25', cents: 2500, detail: 'Prepaid USD balance', label: 'Most common start' },
  { amount: '$50', cents: 5000, detail: 'Prepaid USD balance', label: 'Steady usage' },
  { amount: '$100', cents: 10000, detail: 'Prepaid USD balance', label: 'Higher volume' },
];
const freeChannels = [
  'Instagram text DMs and text comments',
  'Messenger text messages',
  'Telegram bot private messages',
  'Replaid website widget messages',
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Replaid',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '100',
    priceCurrency: 'USD',
    offerCount: String(packages.length + 1),
    url: 'https://replaid.pro/pricing/',
    description: productCopy.pricing,
    offers: [
      {
        '@type': 'Offer',
        name: 'Current supported channel actions',
        price: '0',
        priceCurrency: 'USD',
        description: 'Instagram, Messenger, Telegram, and Replaid widget supported actions do not spend credits.',
      },
      ...packages.map(pack => ({
        '@type': 'Offer',
        name: `${pack.amount} prepaid credits`,
        price: pack.amount.slice(1),
        priceCurrency: 'USD',
        description: `Prepaid USD credits (${pack.cents} cents) for future paid operations at provider cost plus a 20% markup.`,
      })),
    ],
  },
};
---
<Layout title="Pricing | Replaid" description={description} jsonLd={jsonLd}>
  <div class="sky-landing pricing-page">
    <SkyHeader />
    <main id="main" class="pricing-main">
      <header class="pricing-hero">
        <p class="pricing-label">Pricing</p>
        <h1>No subscription.<br /><span class="hero-highlight">Pay only when you need paid ops.</span></h1>
        <p>{productCopy.pricing}</p>
      </header>

      <section class="pricing-free" aria-labelledby="pricing-free-heading">
        <div>
          <span class="pricing-free-badge"><span aria-hidden="true">✓</span> Free today</span>
          <h2 id="pricing-free-heading">Current supported actions stay free.</h2>
          <p>Supported actions on Instagram, Messenger, Telegram, and the Replaid widget do not spend credits. Connect a channel, let your agent read and reply with the permissions you set, and start without a plan.</p>
        </div>
        <ul>
          {freeChannels.map(item => (
            <li><span aria-hidden="true">✓</span><span>{item}</span></li>
          ))}
        </ul>
      </section>

      <section class="pricing-packages" aria-labelledby="pricing-credits-heading">
        <header>
          <h2 id="pricing-credits-heading">Prepaid USD credits</h2>
          <p>Credits are for future paid operations. When an operation has a provider cost, Replaid charges that cost plus a 20% markup against your prepaid balance.</p>
        </header>
        <div class="pricing-grid">
          {packages.map(pack => (
            <article class="pricing-card">
              <strong>{pack.amount}</strong>
              <span>{pack.label}</span>
              <span>{pack.detail}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="pricing-notes" aria-label="Pricing details">
        <article>
          <h3>No monthly tiers</h3>
          <p>Replaid does not sell Starter, Pro, or Agency subscriptions. There is nothing to renew each month for the current free channel actions.</p>
        </article>
        <article>
          <h3>Tax is separate</h3>
          <p>Applicable tax is calculated at checkout when you buy credits. The package amounts above are the prepaid credit values before tax.</p>
        </article>
        <article>
          <h3>Your AI provider is separate</h3>
          <p>ChatGPT, Claude, Hermes Agent, and other agent or model charges stay on your provider account. Replaid does not include an AI agent.</p>
        </article>
      </section>

      <section class="pricing-final" aria-labelledby="pricing-final-heading">
        <h2 id="pricing-final-heading">Ready to connect<br /><span class="hero-highlight">your agent?</span></h2>
        <p>Create a free account, connect one channel, and choose whether your agent drafts for review or sends replies.</p>
        <div class="pricing-final-actions">
          <a class="sky-button" href={registerUrl}>Create your free account</a>
          <a class="pricing-secondary" href={getStartedUrl}>See how to get started<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
        </div>
      </section>
    </main>
    <SkyFooter />
  </div>
</Layout>
