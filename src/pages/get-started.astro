---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import GetStartedLanding from '../components/GetStartedLanding.astro';
import { faqs } from '../components/faq-content';
import '../styles/landing.css';
import '../styles/get-started.css';

const description = 'Connect your website and messaging channels to your AI agent. Read customer messages, create drafts, and send replies with permissions you control.';
const questionTitles = new Set([
  'Does Replaid include an AI agent?',
  'Which channels can I connect?',
  'Can I try it without sending replies?',
  'Does connecting MCP turn on automatic replies?',
  'What does Replaid cost?',
]);
const questions = faqs.filter(faq => questionTitles.has(faq.q));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map(faq => ({
    '@type': 'Question', name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---
<Layout title="Get started with Replaid — Connect your AI agent to your inbox" description={description} jsonLd={jsonLd}>
  <div class="sky-landing start-page">
    <SkyHeader />
    <main id="main"><GetStartedLanding questions={questions} /></main>
    <SkyFooter />
  </div>
</Layout>
