---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import GetStartedLanding from '../components/GetStartedLanding.astro';
import { faqs } from '../components/faq-content';
import '../styles/landing.css';
import '../styles/get-started.css';

const description = 'Request beta access to Replaid and connect a customer channel to your AI agent. Send replies directly or save drafts for review, with permissions you control.';
const questionTitles = new Set([
  'How do I get beta access?',
  'Are there account or message limits?',
  'Can I import past conversations?',
  'Does connecting MCP turn on automatic replies?',
  'What does Replaid cost?',
]);
const questions = faqs.filter(faq => questionTitles.has(faq.q));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map(faq => ({
    '@type': 'Question', name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---
<Layout title="Get Started with Replaid — Connect Your AI Agent" description={description} jsonLd={jsonLd}>
  <div class="sky-landing start-page">
    <SkyHeader />
    <main id="main"><GetStartedLanding questions={questions} /></main>
    <SkyFooter />
  </div>
</Layout>
