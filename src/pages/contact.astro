---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import '../styles/global.css';
import '../styles/landing.css';
import '../styles/contact.css';
---

<Layout title="Contact | Replaid" description="Need help connecting your agent, or have an idea for Replaid? Get in touch." forceLight>
  <div class="sky-landing contact-page">
    <SkyHeader />
    <main id="main" class="contact-main">
      <div class="contact-intro">
        <p class="contact-label">Contact</p>
        <h1>Let’s start a<br /><span class="hero-highlight">conversation.</span></h1>
        <p class="contact-description">Need help connecting your agent, or have an idea for Replaid? We’d love to hear it.</p>
        <a class="contact-email" href="mailto:hi@replaid.pro">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
          hi@replaid.pro
          <svg class="contact-email-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg>
        </a>
      </div>

      <section class="contact-panel" aria-label="Send a message">
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <div class="contact-form-heading">
            <h2>Send a message</h2>
            <p>We’ll reply to the email address below.</p>
          </div>
          <input type="hidden" name="access_key" value="a9640491-09a2-43e9-8125-7c2ea847b64a" />
          <input type="hidden" name="subject" value="New Contact from Replaid.pro" />
          <input type="hidden" name="redirect" value="https://replaid.pro/contact?success=true" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" aria-hidden="true" />

          <div class="contact-field">
            <label for="name">Name</label>
            <input type="text" name="name" id="name" autocomplete="name" required placeholder="Your name" />
          </div>
          <div class="contact-field">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" autocomplete="email" required placeholder="you@example.com" />
          </div>
          <div class="contact-field">
            <label for="message">Message</label>
            <textarea name="message" id="message" rows="5" required placeholder="How can we help?"></textarea>
          </div>
          <div class="contact-submit">
            <div class="h-captcha" data-captcha="true" data-theme="light" data-size="compact"></div>
            <div class="contact-submit-copy">
              <p><a href="/privacy">How we use your details</a></p>
              <button class="sky-button" type="submit">Send message<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></button>
            </div>
          </div>
          <p class="contact-form-fallback">Prefer email? <a href="mailto:hi@replaid.pro">hi@replaid.pro</a></p>
        </form>

        <div id="success-message" class="contact-success" role="status" aria-live="polite" hidden>
          <span class="contact-success-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg></span>
          <h2>Message sent.</h2>
          <p>Thanks for getting in touch. We’ll reply to the email address you provided.</p>
          <a class="sky-button" href="/">Back to homepage</a>
          <a class="contact-another" href="/contact">Send another message</a>
        </div>
      </section>

      <nav class="contact-resources" aria-label="Contact resources">
        <a href="/docs/connect-your-agent">
          <span><strong>Setting things up?</strong><span>Follow the connection guide</span></span>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
        <a href="https://replaid.instatus.com/" target="_blank" rel="noopener noreferrer">
          <span><strong>Something not working?</strong><span>Check service status<span class="sr-only"> (opens in a new tab)</span></span></span>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg>
        </a>
      </nav>
    </main>
    <SkyFooter />
  </div>

  <script src="https://web3forms.com/client/script.js" async defer></script>
  <script>
    if (new URLSearchParams(window.location.search).get('success') === 'true') {
      document.getElementById('contact-form')?.setAttribute('hidden', '');
      document.getElementById('success-message')?.removeAttribute('hidden');
    }
  </script>
</Layout>
