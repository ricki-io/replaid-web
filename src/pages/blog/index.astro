---
import Layout from '../../layouts/Layout.astro';
import SkyHeader from '../../components/SkyHeader.astro';
import SkyFooter from '../../components/SkyFooter.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import '../../styles/landing.css';
import '../../styles/blog.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => Number(a.data.historical) - Number(b.data.historical) || Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id));
const categories = [...new Set(posts.map(post => post.data.category))].sort();
---

<Layout title="AI Customer Messaging Guides — Replaid" description="Practical guides to connecting customer messages to your AI agent, reviewing replies, and managing conversations with Replaid.">
  <div class="sky-landing blog-page">
    <SkyHeader />
    <main id="main" class="blog-main">
      <header class="blog-intro">
        <p class="blog-label">The Replaid blog</p>
        <h1>Ideas for a<br /><span class="hero-highlight">better inbox.</span></h1>
        <p class="blog-description">Practical guides to connecting customer messages to your AI agent, reviewing replies, and managing conversations with Replaid.</p>
      </header>

      <section aria-label="Blog articles">
        <div class="blog-toolbar">
          <div id="blog-filters" class="blog-filters" role="group" aria-label="Filter articles by topic" hidden>
            <button type="button" data-blog-filter="all" aria-pressed="true" aria-controls="blog-list">All articles</button>
            {categories.map(category => <button type="button" data-blog-filter={category} aria-pressed="false" aria-controls="blog-list">{category}</button>)}
          </div>
          <p id="blog-count" class="blog-count" role="status" aria-live="polite">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
        </div>
        <div id="blog-list" class="blog-list" data-filtered="false">
          {posts.map((post, index) => <BlogPostCard post={post} featured={index === 0} />)}
        </div>
        {posts.length === 0 && <div class="blog-empty"><h2>No articles yet.</h2><p>Explore the connection guide while we get the first one ready.</p><a href="/docs/connect-your-agent/">Open the guide</a></div>}
      </section>

      <aside class="blog-cta" aria-labelledby="blog-cta-heading">
        <div><h2 id="blog-cta-heading">Put your agent <span class="hero-highlight">to work.</span></h2><p>Connect your channels. Let your agent help with the replies.</p></div>
        <a class="sky-button" href="/get-started/">Explore Replaid</a>
      </aside>
    </main>
    <SkyFooter />
  </div>
  <script>
    const filters = document.getElementById('blog-filters');
    const list = document.getElementById('blog-list');
    const count = document.getElementById('blog-count');
    const posts = Array.from(list?.querySelectorAll<HTMLElement>('[data-blog-post]') ?? []);
    if (posts.length > 0) filters?.removeAttribute('hidden');
    filters?.querySelectorAll<HTMLButtonElement>('[data-blog-filter]').forEach(button => {
      button.addEventListener('click', () => {
        const category = button.dataset.blogFilter;
        let visible = 0;
        posts.forEach(post => {
          post.hidden = category !== 'all' && post.dataset.category !== category;
          if (!post.hidden) visible++;
        });
        filters.querySelectorAll('button').forEach(filter => filter.setAttribute('aria-pressed', String(filter === button)));
        if (list) list.dataset.filtered = String(category !== 'all');
        if (count) count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
      });
    });
  </script>
</Layout>
