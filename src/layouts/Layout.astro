---
import '@fontsource-variable/inter';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  noindex?: boolean;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  type?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const canonicalPath = /(?:\/|\.html)$/.test(Astro.url.pathname) ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, 'https://replaid.pro/');
const {
  title,
  noindex = false,
  description = "A customer inbox for your AI agent. Connect channels, control actions, and inspect results.",
  ogImage = "/og-image.png",
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  type = "website",
  jsonLd,
} = Astro.props;
const isDefaultSocialImage = ogImage === "/og-image.png";
const socialImageAlt = ogImageAlt ?? (isDefaultSocialImage
  ? "Replaid connects customer channels to your AI agent. Let your AI agent read and reply to customer messages."
  : title);

---

<!doctype html>
<html lang="en" data-appearance="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={new URL(ogImage, 'https://replaid.pro').href} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {(ogImageType || isDefaultSocialImage) && <meta property="og:image:type" content={ogImageType ?? 'image/png'} />}
    {(ogImageWidth || isDefaultSocialImage) && <meta property="og:image:width" content={ogImageWidth ?? 1200} />}
    {(ogImageHeight || isDefaultSocialImage) && <meta property="og:image:height" content={ogImageHeight ?? 630} />}
    <meta property="og:site_name" content="Replaid" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@replaidpro" />
    <meta name="twitter:creator" content="@replaidpro" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, 'https://replaid.pro').href} />

    <meta name="twitter:image:alt" content={socialImageAlt} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])} />
    )}

    <title>{title}</title>

  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <div class="site-content">
      <slot />
    </div>
    <CookieConsent />

  </body>
</html>
