---
import Layout from './Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import SkyFooter from '../components/SkyFooter.astro';
import SetupServiceCallout from '../components/SetupServiceCallout.astro';
import { registration } from '../components/product-copy';
import '../styles/landing.css';
import '../styles/use-cases.css';

interface Props {
  title: string;
  description: string;
  audience: string;
  source: 'agencies' | 'developers' | 'creators' | 'customer-support';
  intro: string;
  primaryGuide?: boolean;
}
const { title, description, audience, source, intro, primaryGuide = false } = Astro.props;
const guideUrl = '/docs/connect-your-agent/';
const registrationUrl = `${registration.url}?from=${source}`;
const relatedUseCases = {
  agencies: { href: '/use-cases/developers/', label: 'Building the integration yourself? Explore Replaid for developers.' },
  developers: { href: '/use-cases/automation-agencies/', label: 'Building for clients? Explore Replaid for automation agencies.' },
  creators: { href: '/use-cases/customer-support/', label: 'Helping customers too? Explore Replaid for customer support.' },
  'customer-support': { href: '/use-cases/developers/', label: 'Connecting your own agent? Explore Replaid for developers.' },
};
const relatedUseCase = relatedUseCases[source];
---
<Layout title={title} description={description}>
  <div class="sky-landing use-case-page">
    <SkyHeader />
    <main id="main" class="use-case-main">
      <section class="use-case-hero" aria-labelledby="use-case-heading">
        <div class="use-case-intro">
          <p class="use-case-label">{audience}</p>
          <h1 id="use-case-heading"><slot name="heading" /></h1>
          <p class="use-case-description">{intro}</p>
          <div class="use-case-actions">
            <a class="sky-button" href={primaryGuide ? guideUrl : registrationUrl}>{primaryGuide ? 'Explore the integration' : registration.label}</a>
            <a class="use-case-link" href={primaryGuide ? registrationUrl : guideUrl}>{primaryGuide ? registration.label : 'See the setup guide'}</a>
          </div>
          <p class="use-case-note">{registration.note}</p>
        </div>
        <slot name="example" />
      </section>
      <slot />
      <SetupServiceCallout source={source} compact />
      <nav class="use-case-related" aria-label="Related use case">
        <a class="use-case-link" href={relatedUseCase.href}>{relatedUseCase.label}</a>
      </nav>
    </main>
    <SkyFooter />
  </div>
</Layout>
